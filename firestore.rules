rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMember(coupleId) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/couples/$(coupleId)).data.members;
    }
    function rec(key) { return get(/databases/$(database)/documents/recovery/$(key)).data; }

    match /codes/{code} {
      allow read: if signedIn();
      allow create: if signedIn();
    }

    match /inbox/{key} {
      allow get: if key.size() >= 30;
      allow create, update: if key.size() >= 30
        && request.resource.data.keys().hasOnly(['texte'])
        && request.resource.data.texte is string
        && request.resource.data.texte.size() < 200000;
    }

    match /recovery/{key} {
      allow get: if key.size() >= 24;
      allow create, update: if key.size() >= 24 && signedIn()
        && request.resource.data.uid == request.auth.uid
        && isMember(request.resource.data.coupleId);
    }

    match /couples/{coupleId} {
      allow create: if signedIn() && request.resource.data.members == [request.auth.uid];
      allow read: if isMember(coupleId);
      allow update: if isMember(coupleId) || (
        signedIn()
        && request.resource.data.members.hasAll(resource.data.members)
        && request.resource.data.members.hasAny([request.auth.uid])
        && request.resource.data.members.size() <= 2
      ) || (
        signedIn()
        && request.resource.data.recoveryKey is string
        && rec(request.resource.data.recoveryKey).coupleId == coupleId
        && rec(request.resource.data.recoveryKey).uid in resource.data.members
        && request.resource.data.members.size() == resource.data.members.size()
        && request.resource.data.members.hasAll(resource.data.members.removeAll([rec(request.resource.data.recoveryKey).uid]))
        && request.resource.data.members.hasAny([request.auth.uid])
      );

      match /{collection}/{docId} {
        allow read, write: if isMember(coupleId);
      }
      match /{collection}/{docId}/{sub}/{subId} {
        allow read, write: if isMember(coupleId);
      }
    }
  }
}
